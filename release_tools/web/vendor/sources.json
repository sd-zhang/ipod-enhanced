  "pako": {
    "repository": "https://github.com/nodeca/pako",
    "version": "2.1.0"
  },
  "local_modifications": [
    {
      "file": "BinFile.js",
      "change": "Respect typed-array byteOffset and byteLength, including the bounded views returned by the bzip decoder."
    },
    {
      "file": "RomPatcher.format.bdf.js",
      "change": "Grow the embedded bzip decoder output to fit an entire RLE run when doubling alone is insufficient."
    },
    {
      "file": "RomPatcher.format.bdf.js",
      "change": "Bound untrusted bzip input, block and output sizes; include byte 255 in its alphabet; validate BSDIFF signed 64-bit controls, intermediate source offsets and stream lengths; preserve zero-valued source bytes outside the original extent."
    },
    {
      "file": "RomPatcher.format.bdf.js",
      "change": "Validate the combined bzip stream CRC, zero padding and exact compressed input consumption; reject appended data or concatenated streams."
    },
    {
      "file": "RomPatcher.format.bdf.js",
      "change": "Reject invalid initial or adjusted Huffman lengths, exhausted selectors and unmatched symbols immediately; refill enough bits for each bounded code length."
    }
  ],
